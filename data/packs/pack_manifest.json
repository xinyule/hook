{
  "schema_version": 2,
  "route": "A",
  "route_note": "忠实复刻，仅内部学习/测试；B 原创化对外路线已取消（用户 2026-11-13 变更）",
  "distribution": "internal_only",
  "public_release": false,
  "default_pack": "internal_reference",
  "export_locked_pack": "internal_reference",
  "packs": {
    "internal_reference": {
      "path": "res://assets/packs/internal_reference/",
      "purpose": "唯一内容包：原作名称、造型、剧情、Boss 名、UI 的忠实对照与实现",
      "in_repository": true,
      "in_export": true,
      "note": "仅存自制/重制资产与对照文本；第三方原作美术、音乐、截图等受版权保护的原始素材不入库"
    }
  },
  "replaceable_fields": [
    "character.display_name",
    "character.portrait",
    "character.model",
    "character.voice",
    "boss.display_name",
    "boss.model",
    "boss.health_bar_label",
    "stage.display_name",
    "stage.skybox",
    "ui.logo",
    "ui.title_screen",
    "ui.font",
    "ui.palette",
    "audio.bgm",
    "audio.sfx",
    "story.text",
    "credits.text"
  ],
  "shared_fields_note": "玩法、数值、关卡结构、招式表统一写在 data/*.json；内容包只负责表达层，便于后续单独替换",
  "launch_args": {
    "pack_selector": "--pack=internal",
    "default": "--pack=internal"
  },
  "restrictions": [
    "不得公开发布、上架、商业化或对外分发任何构建产物",
    "不得把仓库转为 public",
    "不得部署到公开可访问的站点（含 GitHub Pages）",
    "不得把原作截图、原声音乐、原始像素美术等第三方素材提交进仓库"
  ]
}
