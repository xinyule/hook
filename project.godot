config_version=5

[application]

config/name="hook3d (internal) - M8 balance & completeness"
config/description="2.5D side-scrolling faithful remake - M8 balance & completeness - INTERNAL ONLY"
run/main_scene="res://scenes/m8.tscn"
config/version="0.8.0"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
