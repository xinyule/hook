config_version=5

[application]

config/name="hook3d"
config/description="2.5D side-scrolling faithful remake - M9 internal final delivery - INTERNAL ONLY"
run/main_scene="res://scenes/m9.tscn"
config/version="1.0.0"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Android export validation requires ETC2/ASTC texture import to be enabled
; (should_import_etc2_astc()); CI Linux hosts default to S3TC, so set it explicitly.
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
